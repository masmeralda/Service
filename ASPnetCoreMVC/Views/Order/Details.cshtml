@model ASPnetCoreMVC.Models.OrderViewModel

@{
    ViewData["Title"] = "Детали заказа";
}



<!-- Заголовок -->
<div class="container mt-4">
    <h1 class="text-center text-muted">@ViewData["Title"]</h1>

    <!-- Блок с информацией о заказе -->
    <div class="card my-3 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="text-dark">Информация о заказе</h5>
        </div>
        <div class="card-body p-3">
            <table class="table table-sm table-bordered">
                <tr>
                    <th>Номер заказа</th>
                    <td>@Model.IdOrder</td>
                </tr>
                <tr>
                    <th>Статус</th>
                    <td>@Model.StatusOrder</td>
                </tr>
                <tr>
                    <th>Дата создания</th>
                    <td>@Model.CreationDateOrder?.ToString("dd/MM/yyyy")</td>
                </tr>
                <tr>
                    <th>Дата завершения</th>
                    <td>@Model.CompletionDateOrder?.ToString("dd/MM/yyyy")</td>
                </tr>
                <tr>
                    <th>Комментарий</th>
                    <td>@Model.CommentOrder</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- Блок с информацией о клиенте -->
    <div class="card my-3 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="text-dark">Информация о клиенте</h5>
        </div>
        <div class="card-body p-3">
            <p><strong>Фамилия:</strong> @Model.Client.LastNameClient</p>
            <p><strong>Имя:</strong> @Model.Client.FirstNameClient</p>
            <p><strong>Отчество:</strong> @Model.Client.PatronymicClient</p>
            <p><strong>Телефон:</strong> @Model.Client.PhoneClient</p>
            <p><strong>Email:</strong> @Model.Client.EmailClient</p>
            <p><strong>Улица:</strong> @Model.Client.StreetClient</p>
            <p><strong>Дом:</strong> @Model.Client.HouseClient</p>
            <p><strong>Квартира:</strong> @Model.Client.ApartmentNumberClient</p>
        </div>
    </div>

    <!-- Блок с информацией о специалисте -->
    <div class="card my-3 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="text-dark">Информация о специалисте</h5>
        </div>
        <div class="card-body p-3">
            <p><strong>Фамилия:</strong> @Model.Specialist.LastNameSpecialist</p>
            <p><strong>Имя:</strong> @Model.Specialist.FirstNameSpecialist</p>
            <p><strong>Отчество:</strong> @Model.Specialist.PatronymicSpecialist</p>
            <p><strong>Телефон:</strong> @Model.Specialist.PhoneNumberSpecialist</p>
        </div>
    </div>

    <!-- Блок с информацией о сервисе -->
    <div class="card my-3 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="text-dark">Информация о сервисе</h5>
        </div>
        <div class="card-body p-3">
            <table class="table table-sm table-bordered">
                <tr>
                    <th>Название услуги</th>
                    <td>@Model.Service.NameService</td>
                </tr>
                <tr>
                    <th>Цена</th>
                    <td>@Model.Service.PriceService</td>
                </tr>
                <tr>
                    <th>Время выполнения</th>
                    <td>@Model.Service.ExecutionTimeService</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- Блок с информацией о технике -->
    <div class="card my-3 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="text-dark">Информация о технике</h5>
        </div>
        <div class="card-body p-3">
            <table class="table table-sm table-bordered">
                <tr>
                    <th>Описание</th>
                    <td>@Model.Technic.DescriptionTechnic</td>
                </tr>
                <tr>
                    <th>Фото</th>
                    <td>
                        @if (!string.IsNullOrEmpty(Model.Technic.PhotoTechnic))
                        {
                            <!-- Отображение изображения (если это строка base64) -->
                            <img src="data:image/jpeg;base64,@Model.Technic.PhotoTechnic" alt="Фото техники" class="img-fluid" style="max-width: 200px;" />
                        }
                        else
                        {
                            <p>Фото отсутствует</p>
                        }
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <!-- Кнопка для возврата к списку заказов -->
    <div class="text-center my-3">
        <a href="@Url.Action("Index", "Order")" class="btn btn-secondary">Назад к списку заказов</a>
    </div>
</div>

<!-- Подключение Bootstrap JS для корректной работы компонентов -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
