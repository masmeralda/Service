@model IEnumerable<ASPnetCoreMVC.Models.OrderViewModel>

@{
    ViewData["Title"] = "Список заказов";
}

<h1 class="text-center mb-4">@ViewData["Title"]</h1>

<style>

    /* Анимация при наведении на карточку */
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: scale(1.03);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

    .card-body {
        padding: 1.25rem;
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .card-text {
        font-size: 0.875rem;
        margin-bottom: 0.75rem; /* Увеличены отступы */
    }

    .card-subtitle {
        font-size: 0.9rem;
        font-weight: 500;
        color: #6c757d;
        margin-bottom: 0.5rem; /* Добавлен отступ */
    }

    .card-img-top {
        height: 150px;
        object-fit: cover;
        margin-bottom: 1rem;
    }

    .card-footer {
        padding: 0.75rem;
        text-align: right;
        background-color: #f8f9fa;
    }

    /* Добавляем отступы для блока с информацией */
    .card-body p {
        margin-bottom: 1rem;
    }

    /* Дополнительные отступы для разделов */
    .card-body h6 {
        margin-top: 1rem;
        margin-bottom: 0.5rem;
    }
</style>

<!-- Кнопки переходов -->
<div class="d-flex justify-content-start mb-4">
    <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-danger btn-sm me-2">Вернуться в панель управления</a>
</div>

<!-- Форма фильтрации по статусу -->
<form method="get" class="mb-4">
    <div class="row">
        <div class="col">
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                    Фильтровать по статусу
                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                    <li><a class="dropdown-item @(ViewBag.StatusFilter == "" ? "active" : "")" href="?status=">Все статусы</a></li>
                    <li><a class="dropdown-item @(ViewBag.StatusFilter == "Принят оператором" ? "active" : "")" href="?status=Принят оператором">Принят оператором</a></li>
                    <li><a class="dropdown-item @(ViewBag.StatusFilter == "Принят инженером" ? "active" : "")" href="?status=Принят инженером">Принят инженером</a></li>
                    <li><a class="dropdown-item @(ViewBag.StatusFilter == "Завершен" ? "active" : "")" href="?status=Завершен">Завершен</a></li>
                    <li><a class="dropdown-item @(ViewBag.StatusFilter == "Отменен" ? "active" : "")" href="?status=Отменен">Отменен</a></li>
                </ul>
            </div>
        </div>
    </div>
</form>

<!-- Ряд карточек для отображения заказов -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var order in Model)
    {
        <div class="col">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Заказ №@order.IdOrder</h5>
                    <p class="card-text"><strong>Статус:</strong> @order.StatusOrder</p>
                    <p class="card-text"><strong>Дата создания:</strong> @order.CreationDateOrder?.ToString("dd/MM/yyyy")</p>
                    <p class="card-text"><strong>Дата завершения:</strong> @order.CompletionDateOrder?.ToString("dd/MM/yyyy")</p>
                    <p class="card-text"><strong>Комментарий:</strong> @order.CommentOrder</p>

                    <h6 class="card-subtitle mb-2">Техника</h6>
                    <p>@order.Technic.DescriptionTechnic</p>
                    @if (!string.IsNullOrEmpty(order.Technic.PhotoTechnic))
                    {
                        <img src="data:image/png;base64,@order.Technic.PhotoTechnic" alt="Фото техники" class="card-img-top" />
                    }
                    else
                    {
                        <p>Фото отсутствует</p>
                    }

                    <h6 class="card-subtitle mb-2">Информация о клиенте</h6>
                    <p>
                        @order.Client.LastNameClient @order.Client.FirstNameClient @order.Client.PatronymicClient <br />
                        @order.Client.PhoneClient <br />
                        @order.Client.EmailClient
                    </p>

                    <h6 class="card-subtitle mb-2">Информация о специалисте</h6>
                    <p>
                        @order.Specialist.LastNameSpecialist @order.Specialist.FirstNameSpecialist @order.Specialist.PatronymicSpecialist <br />
                        @order.Specialist.PhoneNumberSpecialist
                    </p>

                    <h6 class="card-subtitle mb-2">Услуга</h6>
                    <p>
                        @order.Service.NameService <br />
                        Цена: @order.Service.PriceService <br />
                        Время выполнения: @order.Service.ExecutionTimeService
                    </p>
                </div>
                <div class="card-footer">
                    <!-- Кнопка редактирования -->
                    <a href="@Url.Action("Engineer_Edit", "Order", new { id = order.IdOrder })" class="btn btn-outline-primary btn-sm me-2">Подробнее</a>
                </div>
            </div>
        </div>
    }
</div>
