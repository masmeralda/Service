@model ASPnetCoreMVC.Models.OrderViewModel

@{
    ViewData["Title"] = "Создание нового заказ";
}

<h2 class="text-center my-4">@ViewData["Title"]</h2>

<!-- Обернем форму в container-sm для ограничения ширины -->
<form asp-action="Create" method="post" class="p-4 rounded shadow-lg bg-light container-sm">
    <div class="form-group mb-3">
        <label asp-for="StatusOrder" class="form-label">Статус заказа</label>
        <input asp-for="StatusOrder" class="form-control" value="Принят оператором" readonly />
        <span asp-validation-for="StatusOrder" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="CreationDateOrder" class="form-label">Дата создания</label>
        <input asp-for="CreationDateOrder" class="form-control" type="date" id="CreationDateOrder" readonly />
        <span asp-validation-for="CreationDateOrder" class="text-danger"></span>
    </div>

    <script>
        document.getElementById('CreationDateOrder').value = new Date().toISOString().split('T')[0];
    </script>

    <div class="form-group mb-3">
        <label asp-for="CompletionDateOrder" class="form-label">Дата завершения</label>
        <input asp-for="CompletionDateOrder" class="form-control" type="date" readonly />
        <span asp-validation-for="CompletionDateOrder" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label for="ClientId" class="form-label">Клиент</label>
        <select asp-for="ClientId" class="form-control" asp-items="@(ViewData["ClientName"] as SelectList)">
            <option value="">Выберите клиента</option>
        </select>
        <span asp-validation-for="ClientId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label for="SpecialistId" class="form-label">Специалист</label>
        <select asp-for="SpecialistId" class="form-control" asp-items="@(ViewData["SpecialistName"] as SelectList)">
            <option value="">Выберите специалиста</option>
        </select>
        <span asp-validation-for="SpecialistId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label for="TechnicId" class="form-label">Устройство</label>
        <select asp-for="TechnicId" class="form-control" asp-items="@(ViewData["TechnicName"] as SelectList)">
            <option value="">Выберите технику</option>
        </select>
        <span asp-validation-for="TechnicId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label for="ServiceId" class="form-label">Услуга</label>
        <select asp-for="ServiceId" class="form-control" asp-items="@(ViewData["ServiceName"] as SelectList)">
            <option value="">Выберите услугу</option>
        </select>
        <span asp-validation-for="ServiceId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="CommentOrder" class="form-label">Комментарий</label>
        <textarea asp-for="CommentOrder" class="form-control" placeholder="Введите комментарий"></textarea>
        <span asp-validation-for="CommentOrder" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between">
        <button type="submit" class="btn btn-success">Создать заказ</button>
        <a href="@Url.Action("Index", "Order")" class="btn btn-outline-secondary">Отмена</a>
    </div>
</form>
