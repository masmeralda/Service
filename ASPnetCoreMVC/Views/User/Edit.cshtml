@model ASPnetCoreMVC.Models.UserViewModel

@{
    ViewData["Title"] = "Редактировать пользователя";
}

<h2 class="text-center my-4">Редактирование пользователя</h2>

<form asp-action="Edit" method="post" class="p-4 rounded shadow-lg bg-light">
    <input type="hidden" asp-for="IdUser" />

    <div class="form-group mb-3">
        <label for="LoginUser" class="form-label">Логин</label>
        <input asp-for="LoginUser" class="form-control" id="LoginUser" required placeholder="Введите логин" />
        <span asp-validation-for="LoginUser" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label for="PasswordUser" class="form-label">Пароль</label>
        <input asp-for="PasswordUser" type="password" class="form-control" id="PasswordUser" required placeholder="Введите пароль" />
        <span asp-validation-for="PasswordUser" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label for="IdRole" class="form-label">Роль</label>
        <select asp-for="IdRole" class="form-control" id="IdRole" asp-items="@ViewBag.Roles"></select>
        <span asp-validation-for="IdRole" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between">
        <button type="submit" class="btn btn-success">Сохранить изменения</button>
        <button onclick="window.history.back();" type="button" class="btn btn-outline-secondary">Отмена</button>
    </div>
</form>
