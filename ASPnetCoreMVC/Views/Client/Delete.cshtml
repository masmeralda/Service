@model ASPnetCoreMVC.Models.ClientViewModel

@{
    ViewData["Title"] = "Delete Client";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Client ID: @Model.IdClient</h4>
    <dl class="row">
        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.LastNameClient</dd>
        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.FirstNameClient</dd>
        <dt class="col-sm-2">Patronymic</dt>
        <dd class="col-sm-10">@Model.PatronymicClient</dd>
        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.PhoneClient</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.EmailClient</dd>
        <dt class="col-sm-2">Street</dt>
        <dd class="col-sm-10">@Model.StreetClient</dd>
        <dt class="col-sm-2">House</dt>
        <dd class="col-sm-10">@Model.HouseClient</dd>
        <dt class="col-sm-2">Apartment Number</dt>
        <dd class="col-sm-10">@Model.ApartmentNumberClient</dd>
    </dl>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a href="@Url.Action("Index", "Client")" class="btn btn-secondary">Cancel</a>
</form>
