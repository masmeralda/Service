@model IEnumerable<ASPnetCoreMVC.Models.ClientViewModel>

<h2 class="text-center mb-4">Клиенты</h2>

<a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-danger btn-sm">Вернуться в панель управления</a>
<a href="@Url.Action("Create", "Client")" class="btn btn-outline-danger btn-sm">Добавить нового клиента</a>

<style>
    /* Настройка таблицы */
    table {
        margin-top: 20px;
        border-radius: 8px;
        overflow: hidden;
    }

    th, td {
        vertical-align: middle;
        text-align: left;
        padding: 15px;
    }

    th {
        font-weight: bold;
    }

    .table-striped tbody tr:nth-child(odd) {
        background-color: #fafdff;
    }

    .table-hover tbody tr:hover {
        background-color: #fafdff;
    }

    .table-responsive {
        overflow-x: auto;
    }

    /* Кнопка удалить */
    .btn-outline-danger {
        padding: 5px 10px;
    }

    /* Стиль для строки, чтобы она была кликабельной */
    .clickable-row {
        cursor: pointer;
    }

    .text-end {
        text-align: right;
    }
</style>

<form method="get" class="mb-4 mt-4">
    <div class="input-group">
        <input type="text" name="searchQuery" class="form-control" placeholder="Поиск по фамилии, имени и отчеству" value="@ViewBag.SearchQuery" />
        <button type="submit" class="btn btn-outline-primary">Поиск</button>
    </div>
</form>


<div class="table-responsive">
    <table class="table table-hover table-striped">
        <thead class="table-light">
            <tr>
                <th>Фамилия</th>
                <th>Имя</th>
                <th>Отчество</th>
                <th>Телефон</th>
                <th>Email</th>
                <th>Улица</th>
                <th>Дом</th>
                <th>Квартира</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr data-id="@client.IdClient" class="clickable-row">
                    <td>@client.LastNameClient</td>
                    <td>@client.FirstNameClient</td>
                    <td>@client.PatronymicClient</td>
                    <td>@client.PhoneClient</td>
                    <td>@client.EmailClient</td>
                    <td>@client.StreetClient</td>
                    <td>@client.HouseClient</td>
                    <td>@client.ApartmentNumberClient</td>
                    <td class="text-end">
                        <form action="@Url.Action("Delete", "Client", new { id = client.IdClient })" method="post" onsubmit="return confirm('Вы уверены, что хотите удалить этого клиента?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<script>
    // Добавляем обработчик событий для всех строк таблицы
    document.querySelectorAll('.clickable-row').forEach(row => {
        row.addEventListener('click', function() {
            var clientId = this.getAttribute('data-id');
            // Перенаправляем на страницу редактирования
            window.location.href = '@Url.Action("Edit", "Client", new { id = "__id__" })'.replace('__id__', clientId);
        });
    });
</script>


