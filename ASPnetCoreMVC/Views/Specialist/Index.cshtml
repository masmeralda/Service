@model IEnumerable<ASPnetCoreMVC.Models.SpecialistViewModel>

<h2 class="text-center mb-4">Список Специалистов</h2>

<a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-danger btn-sm">Вернуться в панель управления</a>
<a href="@Url.Action("Create", "Specialist")" class="btn btn-outline-danger btn-sm">Добавить нового специалиста</a>

<style>
    /* Настройка таблицы */
    table {
        margin-top: 20px;
        border-radius: 8px;
        overflow: hidden;
    }

    th, td {
        vertical-align: middle;
        text-align: left;
        padding: 15px;
    }

    th {
        font-weight: bold;
    }

    .table-striped tbody tr:nth-child(odd) {
        background-color: #fafdff;
    }

    .table-hover tbody tr:hover {
        background-color: #fafdff;
    }

    .table-responsive {
        overflow-x: auto;
    }

    /* Кнопка удалить */
    .btn-outline-danger {
        padding: 5px 10px;
    }

    /* Стиль для строки, чтобы она была кликабельной */
    .clickable-row {
        cursor: pointer;
    }

    .text-end {
        text-align: right;
    }
</style>

<div class="table-responsive">
    <table class="table table-hover table-striped">
        <thead class="table-light">
            <tr>
                <th>Фамилия</th>
                <th>Имя</th>
                <th>Отчество</th>
                <th>Телефон</th>
                <th>Должность</th>
                <th>Пользователь</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var specialist in Model)
            {
                <tr data-id="@specialist.IdSpecialist" class="clickable-row">
                    <td>@specialist.LastNameSpecialist</td>
                    <td>@specialist.FirstNameSpecialist</td>
                    <td>@specialist.PatronymicSpecialist</td>
                    <td>@specialist.PhoneNumberSpecialist</td>
                    <td>@specialist.NamePosition?.NamePosition</td>
                    <td>@specialist.LoginUser?.LoginUser</td>
                    <td class="text-end">
                        <form action="@Url.Action("Delete", "Specialist", new { id = specialist.IdSpecialist })" method="post" onsubmit="return confirm('Вы уверены, что хотите удалить этого специалиста?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    // Добавляем обработчик событий для всех строк таблицы
    document.querySelectorAll('.clickable-row').forEach(row => {
        row.addEventListener('click', function() {
            var specialistId = this.getAttribute('data-id');
            // Перенаправляем на страницу редактирования
            window.location.href = '@Url.Action("Edit", "Specialist", new { id = "__id__" })'.replace('__id__', specialistId);
        });
    });
</script>
